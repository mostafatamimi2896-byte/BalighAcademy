@page "/students"
@using BalighAcademy.Services
@inject StudentService Svc

<PageTitle>زبان‌آموزان | Students</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">زبان‌آموزان / Students</MudText>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudPaper Elevation="2" Class="pa-4 mb-6">
    <MudText Typo="Typo.subtitle1" Class="mb-3">ثبت‌نام زبان‌آموز جدید</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.FirstName" Label="نام" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.LastName" Label="نام خانوادگی" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.FirstNameEn" Label="First Name" Style="direction:ltr; text-align:left" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.LastNameEn" Label="Last Name" Style="direction:ltr; text-align:left" /></MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_new.Gender" Label="جنسیت">
                <MudSelectItem Value="@("پسر / Boy")">پسر / Boy</MudSelectItem>
                <MudSelectItem Value="@("دختر / Girl")">دختر / Girl</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.BirthDate" Label="تاریخ تولد (1390-01-01)" Style="direction:ltr; text-align:left" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.Mobile" Label="موبایل" Style="direction:ltr; text-align:left" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.Phone" Label="تلفن" Style="direction:ltr; text-align:left" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_new.Email" Label="Email" Style="direction:ltr; text-align:left" /></MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_new.QuotaType" Label="نوع سهمیه">
                <MudSelectItem Value="@("عادی / Regular")">عادی / Regular</MudSelectItem>
                <MudSelectItem Value="@("ایثارگر / Veteran Family")">ایثارگر / Veteran Family</MudSelectItem>
                <MudSelectItem Value="@("بنیاد / Foundation")">بنیاد / Foundation</MudSelectItem>
                <MudSelectItem Value="@("خانواده / Family")">خانواده / Family</MudSelectItem>
                <MudSelectItem Value="@("بورسیه / Scholarship")">بورسیه / Scholarship</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_new.Status" Label="وضعیت">
                <MudSelectItem Value="@("فعال / Active")">فعال / Active</MudSelectItem>
                <MudSelectItem Value="@("غیرفعال / Inactive")">غیرفعال / Inactive</MudSelectItem>
                <MudSelectItem Value="@("انصراف / Withdrawn")">انصراف / Withdrawn</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="_new.Address" Label="آدرس" /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="_new.Notes" Label="توضیحات" Lines="2" /></MudItem>
    </MudGrid>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Class="mt-4" StartIcon="@Icons.Material.Filled.Save">ذخیره</MudButton>
</MudPaper>

<MudPaper Elevation="2" Class="pa-4">
    <MudTextField @bind-Value="_q" Placeholder="جستجو: نام، کد، موبایل..." Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="Search" Immediate="true" OnKeyDown="OnKey" Class="mb-4" />

    <MudTable Items="_students" Hover="true" Elevation="2" Striped="true">
        <HeaderContent>
            <MudTh>کد</MudTh>
            <MudTh>نام</MudTh>
            <MudTh>نام خانوادگی</MudTh>
            <MudTh>First Name</MudTh>
            <MudTh>Last Name</MudTh>
            <MudTh>موبایل</MudTh>
            <MudTh>وضعیت</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudLink Href="@($"/students/{context.Id}")">@context.StudentCode</MudLink></MudTd>
            <MudTd>@context.FirstName</MudTd>
            <MudTd>@context.LastName</MudTd>
            <MudTd>@context.FirstNameEn</MudTd>
            <MudTd>@context.LastNameEn</MudTd>
            <MudTd>@context.Mobile</MudTd>
            <MudTd>@context.Status</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private List<StudentDto> _students = new();
    private
