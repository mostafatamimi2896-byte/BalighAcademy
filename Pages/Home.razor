@page "/"

<PageTitle>بلیغ | Baligh</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">خوش آمدید 🌹</MudText>
<MudText Typo="Typo.body1">به سامانهٔ مدیریت <b>آکادمی زبان بلیغ</b> خوش آمدید.</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">Welcome to Baligh International Language Academy</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h6">زبان‌آموزان / Students</MudText>
                <MudText Typo="Typo.body2">ثبت‌نام، پرونده، کارت، کارنامه</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h6">اساتید / Teachers</MudText>
                <MudText Typo="Typo.body2">حقوق، فیش حقوقی، حضور و غیاب</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Class" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h6">کلاس‌ها / Classes</MudText>
                <MudText Typo="Typo.body2">تعریف ترم، برنامهٔ هفتگی، آزمون</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h6">امور مالی / Finance</MudText>
                <MudText Typo="Typo.body2">شهریه، اقساط، تخفیف‌ها</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h6">گزارش‌ها / Reports</MudText>
                <MudText Typo="Typo.body2">مالی، اداری، چاپ دوزبانه</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Sms" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.h6">پیامک / SMS</MudText>
                <MudText Typo="Typo.body2">یادآور زادروز، اطلاع‌رسانی کلاس</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
